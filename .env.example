# =============================================
# FirmBrain.AI -- environment template
# =============================================
# Copy this file to ".env" and fill in your values.
# .env is gitignored; .env.example is safe to commit (no real secrets).
#
# NOTE ON PHASE 1: the current dev setup uses the AnythingLLM DESKTOP app
# and native Ollama. The web port (ANYTHINGLLM_PORT) and HOST_IP only take
# effect in Phase 2+, when AnythingLLM runs as a server on the office LAN.

# --- Ollama ---
# Port the local Ollama API listens on (default 11434).
OLLAMA_PORT=11434

# --- AnythingLLM ---
# Port the AnythingLLM web UI will be reachable on (default 3001).
# Phase 1: Desktop app, not used yet. Phase 2: staff use http://HOST_IP:3001.
ANYTHINGLLM_PORT=3001

# --- Models ---
# Default chat model for the low-spec dev machine (see models.txt).
CHAT_MODEL=qwen2.5:1.5b

# Embedding model used for document search / RAG.
EMBEDDING_MODEL=nomic-embed-text

# --- Network ---
# Static IP of the host machine on the office LAN (Phase 2+).
# Staff will open http://HOST_IP:3001 in their browser.
HOST_IP=192.168.1.50